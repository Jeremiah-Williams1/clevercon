# Staging env. Copy with ./gen-env.sh (fills every __TOKEN__). Never commit .env.staging.
NODE_ENV=production
NETWORK=testnet
BACKEND=full
# 0 = no proxy in front (we reach the API through an SSM tunnel)
TRUST_PROXY=0
LOG_LEVEL=info

# Data stores (service names from the compose file, not localhost)
POSTGRES_PASSWORD=__PG__
REDIS_PASSWORD=__REDIS__
DATABASE_URL=postgresql://clevercon:__PG__@postgres:5432/clevercon
REDIS_URL=redis://:__REDIS__@redis:6379

# API / auth
API_PORT=4100
JWT_SECRET=__JWT__
JWT_ACCESS_TTL=15m
HOME_DOMAIN=localhost
WEB_AUTH_DOMAIN=localhost
# Blank = ephemeral key; sign-in challenges don't survive a restart. Pin one later.
SERVER_SIGNING_KEY=
CORS_ORIGINS=http://localhost:5173

# BACK THIS UP: lose it and every stored delegate becomes undecryptable.
DELEGATE_ENCRYPTION_KEY=__DELEGATE__

# Stellar / contracts (shared Testnet contracts for now)
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
AGENT_VAULT_CONTRACT_ID=CDVMPHPD3V6KNVS2ORBQD6A6FSWDCHN7RK2LW4C2KUPHZLM5H3KNKK6A
POLICY_VERIFIER_CONTRACT_ID=CAAVG3JI4EM67LRZ7ZIVFZG7U7UP6RT5GH7DPIIFSLTBFUQBZADWJ4W5
USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Filled by gen-env.sh from the two IDs above
INDEXER_CONTRACT_IDS=

AGENT_PROVIDER=auto

# Tracing off: leave this line absent. An empty value fails URL validation.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://...